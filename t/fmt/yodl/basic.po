#. type: paragraph
#: basic.yo:1
msgid "This is a sample YODL document used to test the po4a YODL parser."
msgstr "THIS IS A SAMPLE YODL DOCUMENT USED TO TEST THE PO4A YODL PARSER."

#. type: paragraph
#: basic.yo:3
msgid ""
"The tt(yodl) program reads one or more input files and writes one output "
"file.  Inline macros such as em(italic) stay inside the whole paragraph."
msgstr ""
"THE TT(YODL) PROGRAM READS ONE OR MORE INPUT FILES AND WRITES ONE OUTPUT "
"FILE.  INLINE MACROS SUCH AS EM(ITALIC) STAY INSIDE THE WHOLE PARAGRAPH."

#. type: center
#: basic.yo:7
msgid "tt(yodl) em(flags) em(inputfile) em(\\[inputfile...\\])"
msgstr "TT(YODL) EM(FLAGS) EM(INPUTFILE) EM(\\[INPUTFILE...\\])"

#. type: itemization/it
#: basic.yo:11
msgid "tt(-D) em(name): Defines em(name) as a symbol."
msgstr "TT(-D) EM(NAME): DEFINES EM(NAME) AS A SYMBOL."

#. type: itemization/it
#: basic.yo:12
msgid "tt(-I) em(directory): Searches include files in a directory."
msgstr "TT(-I) EM(DIRECTORY): SEARCHES INCLUDE FILES IN A DIRECTORY."

#. type: chapter
#: basic.yo:15
msgid "Using the yodl program"
msgstr "USING THE YODL PROGRAM"

#. type: paragraph
#: basic.yo:17
msgid "Some text containing the"
msgstr "SOME TEXT CONTAINING THE"

#. type: paragraph
#: basic.yo:17
msgid "macro, which is never translated."
msgstr "MACRO, WHICH IS NEVER TRANSLATED."

#. type: paragraph
#: basic.yo:20
msgid "nested(foo(bar baz), qux) ends this document with an escaped paren \\(x\\)."
msgstr "NESTED(FOO(BAR BAZ), QUX) ENDS THIS DOCUMENT WITH AN ESCAPED PAREN \\(X\\)."
